# Cle publique CARTO Basemaps optionnelle, limitee aux domaines de production.
# Copier ce parametre dans .env.production avant la compilation.
REACT_APP_CARTO_API_KEY=

# Services compatibles Photon et OSRM (HTTPS et CORS requis).
# Les valeurs publiques ci-dessous conviennent aux essais, sans garantie de service.
# En production, utiliser des instances propres ou un fournisseur autorisant le trafic commercial.
REACT_APP_GEOCODER_URL=https://photon.komoot.io
REACT_APP_ROUTING_URL=https://router.project-osrm.org
