# =============================================================
# Econnect VTC – Backend environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================

# Server
PORT=8001

# MongoDB (Atlas or self-hosted)
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<AppName>
DB_NAME=econnect_vtc

# JWT
JWT_SECRET=<generate-a-strong-random-secret-min-32-chars>
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_live_<your-stripe-secret-key>
STRIPE_WEBHOOK_SECRET=whsec_<your-stripe-webhook-secret>

# URLs
FRONTEND_URL=https://econnect-vtc.com
BACKEND_URL=https://api.econnect-vtc.com

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=https://econnect-vtc.com,https://www.econnect-vtc.com

# Email (Brevo Transactional)
BREVO_API_KEY=xkeysib-<your-brevo-api-key>
BREVO_SENDER_EMAIL=noreply@econnect-vtc.com
BREVO_SENDER_NAME=Econnect VTC
BREVO_TEMPLATE_ACCOUNT_ACTIVATION=
BREVO_TEMPLATE_PASSWORD_RESET=
BREVO_TEMPLATE_BOOKING_CREATED=
BREVO_TEMPLATE_QUOTE_AVAILABLE=
BREVO_TEMPLATE_PAYMENT_CONFIRMED=
BREVO_TEMPLATE_DRIVER_ASSIGNED=
BREVO_TEMPLATE_BOOKING_COMPLETED=
BREVO_TEMPLATE_INVOICE=
BREVO_TEMPLATE_CANCELLATION=
BREVO_TEMPLATE_ADMIN_MESSAGE=

# Admin bootstrap (used only on first start-up if no admin exists)
# Leave unset to skip admin creation in production – create the account manually.
ADMIN_EMAIL=admin@econnect-vtc.com
ADMIN_PASSWORD=<choose-a-strong-password>

# Environment
ENV=production
